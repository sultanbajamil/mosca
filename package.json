{
  "name": "mosca-pqc",
  "version": "1.0.0",
  "description": "MOSCA — post-quantum cryptography exposure scanner. Finds quantum-vulnerable crypto in source code, config files and live TLS endpoints, scores harvest-now-decrypt-later risk with Mosca's inequality, and emits a CycloneDX CBOM.",
