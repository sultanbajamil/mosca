{
  "name": "mosca-pqc",
  "version": "3.1.0",
  "description": "MOSCA — CI-native post-quantum exposure scanner. Finds quantum-vulnerable crypto in source, config, artifacts and dependencies; probes TLS, SSH, STARTTLS, QUIC and IKEv2; harvests recorded TLS/SSH handshakes from PCAP/PCAPNG; benchmarks global PQC readiness by sector; gates on CNSA 2.0, NIST 2030, PCI DSS and HIPAA; explains remediations; and emits CycloneDX CBOM, SARIF, Mermaid and dynamic SVG badges.",
  "type": "module",
  "bin": {
    "mosca": "bin/mosca.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./pcap": "./src/net/pcap.js",
    "./benchmark": "./src/benchmark.js",
    "./badge": "./src/report/badge.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "benchmarks/targets.json",
    "benchmarks/snapshot.json",
    "docs/METHODOLOGY.md",
    "docs/ARCHITECTURE.md",
    "docs/logo.svg",
    "docs/state-of-pqc.html",
    "docs/state-of-pqc.svg",
    "docs/launch-kit",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/sultanbajamil/mosca#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sultanbajamil/mosca.git"
  },
  "bugs": {
    "url": "https://github.com/sultanbajamil/mosca/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/mosca.js demo",
    "scan": "node bin/mosca.js scan",
    "tls": "node bin/mosca.js tls",
    "ssh": "node bin/mosca.js ssh",
    "starttls": "node bin/mosca.js starttls",
    "quic": "node bin/mosca.js quic",
    "ikev2": "node bin/mosca.js ikev2",
    "pcap": "node bin/mosca.js pcap",
    "benchmark": "node scripts/benchmark-world.js",
    "benchmark:replay": "node scripts/benchmark-world.js --snapshot benchmarks/snapshot.json",
    "fix": "node bin/mosca.js fix",
    "explain": "node bin/mosca.js explain",
    "validate": "node scripts/validate-artifacts.js",
    "check": "node scripts/check-zero-deps.js && node --test"
  },
  "keywords": [
    "post-quantum",
    "pqc",
    "cryptography",
    "cbom",
    "cyclonedx",
    "harvest-now-decrypt-later",
    "hndl",
    "mosca",
    "security",
    "sbom",
    "ml-kem",
    "ml-dsa",
    "tls",
    "ssh",
    "quic",
    "starttls",
    "ikev2",
    "pcap",
    "pcapng",
    "packet-capture",
    "x509",
    "baseline",
    "badge",
    "benchmark",
    "quantum-readiness",
    "github-actions",
    "scanner",
    "compliance",
    "cnsa-2.0",
    "pci-dss",
    "hipaa",
    "mermaid"
  ],
  "author": "sultanbajamil",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
