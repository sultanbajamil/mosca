{
  "name": "mosca-pqc",
  "version": "3.0.0",
  "description": "MOSCA — CI-native post-quantum cryptography exposure scanner. Finds quantum-vulnerable crypto in source, config, key artifacts and dependency lockfiles; probes TLS, SSH, STARTTLS, QUIC and IKEv2; analyses X.509 chains; gates on CNSA 2.0, NIST 2030, PCI DSS and HIPAA; proposes reviewable fixes; and emits CycloneDX CBOM, SARIF and Mermaid.",
  "type": "module",
  "bin": {
    "mosca": "bin/mosca.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "docs/METHODOLOGY.md",
    "docs/ARCHITECTURE.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/sultanbajamil/mosca#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sultanbajamil/mosca.git"
  },
  "bugs": {
    "url": "https://github.com/sultanbajamil/mosca/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/mosca.js demo",
    "scan": "node bin/mosca.js scan",
    "tls": "node bin/mosca.js tls",
    "ssh": "node bin/mosca.js ssh",
    "starttls": "node bin/mosca.js starttls",
    "quic": "node bin/mosca.js quic",
    "ikev2": "node bin/mosca.js ikev2",
    "fix": "node bin/mosca.js fix",
    "explain": "node bin/mosca.js explain",
    "validate": "node scripts/validate-artifacts.js",
    "check": "node scripts/check-zero-deps.js && node --test"
  },
  "keywords": [
    "post-quantum",
    "pqc",
    "cryptography",
    "cbom",
    "cyclonedx",
    "harvest-now-decrypt-later",
    "hndl",
    "mosca",
    "security",
    "sbom",
    "ml-kem",
    "ml-dsa",
    "tls",
    "ssh",
    "quic",
    "starttls",
    "ikev2",
    "x509",
    "baseline",
    "github-actions",
    "scanner",
    "compliance",
    "cnsa-2.0",
    "pci-dss",
    "hipaa",
    "mermaid"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
